#run this command on terminal and we will get log on kibana(live)
cat > /tmp/generate-logs.sh << 'EOF'
#!/bin/bash
LEVELS=("INFO" "WARNING" "ERROR" "DEBUG" "CRITICAL")
SERVICES=("tomcat" "postgres" "haproxy" "pgpool" "nginx")
MESSAGES=(
  "Connection established"
  "Request processed successfully"
  "Database query executed"
  "Health check passed"
  "Cache miss detected"
  "Authentication failed"
  "Timeout occurred"
  "Service restarted"
)

while true; do
  LEVEL=${LEVELS[$RANDOM % ${#LEVELS[@]}]}
  SERVICE=${SERVICES[$RANDOM % ${#SERVICES[@]}]}
  MSG=${MESSAGES[$RANDOM % ${#MESSAGES[@]}]}
  logger -n 127.0.0.1 -P 514 --udp "[$LEVEL] $SERVICE: $MSG at $(date '+%Y-%m-%d %H:%M:%S')"
  sleep 1
done
EOF

chmod +x /tmp/generate-logs.sh
/tmp/generate-logs.sh
